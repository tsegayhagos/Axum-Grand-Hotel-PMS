<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Housekeeping Task Kanban -->
    <record id="view_hotel_housekeeping_task_kanban" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.kanban</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="room_id"/>
                <field name="task_type"/>
                <field name="priority"/>
                <field name="attendant_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-3 shadow-sm rounded border">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h4 class="mb-0 font-weight-bold text-dark">
                                    Room <field name="room_id"/>
                                </h4>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="text-primary font-weight-bold mb-1">
                                <field name="task_type"/>
                            </div>
                            <div class="text-muted small mb-2">
                                <i class="fa fa-user me-1"/> <field name="attendant_id"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="badge rounded-pill bg-secondary"><field name="state"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Housekeeping Task List View -->
    <record id="view_hotel_housekeeping_task_tree" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.list</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <list decoration-danger="priority == '2'"
                  decoration-warning="priority == '1'"
                  decoration-success="state == 'inspected'"
                  decoration-info="state == 'cleaned'">
                <field name="name"/>
                <field name="room_id"/>
                <field name="floor_id"/>
                <field name="task_type"/>
                <field name="priority" widget="priority"/>
                <field name="attendant_id"/>
                <field name="scheduled_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Housekeeping Task Form View -->
    <record id="view_hotel_housekeeping_task_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.task.form</field>
        <field name="model">hotel.housekeeping.task</field>
        <field name="arch" type="xml">
            <form string="Housekeeping Task">
                <header>
                    <button name="action_start_cleaning" string="Start Work" type="object" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_mark_cleaned" string="Mark Cleaned" type="object" class="btn-info" invisible="state != 'in_progress'"/>
                    <button name="action_mark_inspected" string="Approve &amp; Inspect" type="object" class="btn-success" invisible="state != 'cleaned'"/>
                    <button name="action_post_minibar_charges" string="Post Minibar Charges to Folio" type="object" class="btn-warning" invisible="minibar_total &lt;= 0"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_progress,cleaned,inspected"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Task Reference"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Room &amp; Assignment">
                            <field name="room_id"/>
                            <field name="floor_id"/>
                            <field name="task_type"/>
                            <field name="priority" widget="priority"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Personnel &amp; Schedule">
                            <field name="attendant_id"/>
                            <field name="supervisor_id"/>
                            <field name="scheduled_date"/>
                            <field name="start_time" readonly="1" invisible="not start_time"/>
                            <field name="end_time" readonly="1" invisible="not end_time"/>
                            <field name="reservation_id" readonly="1" invisible="not reservation_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sanitation &amp; Hygiene Checklist">
                            <group>
                                <group string="Bedding &amp; Surfaces">
                                    <field name="check_bed_linen"/>
                                    <field name="check_vacuumed"/>
                                    <field name="check_trash_cleared"/>
                                </group>
                                <group string="Sanitary &amp; Amenities">
                                    <field name="check_bathroom_sanitized"/>
                                    <field name="check_amenities_restocked"/>
                                    <field name="check_minibar"/>
                                </group>
                            </group>
                            <field name="notes" placeholder="Room inspection notes, guest items left behind..."/>
                        </page>
                        <page string="Minibar Consumed Items">
                            <field name="minibar_line_ids">
                                <list editable="bottom">
                                    <field name="item_name"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="price_subtotal"/>
                                    <field name="posted" widget="boolean_toggle"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="minibar_total" class="oe_subtotal_footer_separator font-weight-bold"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action & Menus -->
    <record id="action_hotel_housekeeping_task" model="ir.actions.act_window">
        <field name="name">Housekeeping Tasks</field>
        <field name="res_model">hotel.housekeeping.task</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_hotel_housekeeping_tasks"
              name="Room Cleaning Tasks"
              parent="menu_hotel_housekeeping_root"
              action="action_hotel_housekeeping_task"
              sequence="10"/>
</odoo>
